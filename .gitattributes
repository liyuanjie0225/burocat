# Normalize line endings: repo works in LF everywhere (upstream checked in some CRLF
# files; renormalized merges treat them as equal so diffs stay about real changes).
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
